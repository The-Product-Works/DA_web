# Reference settings for a Metabase dashboard build script (build_metabase_dashboard.py).
# That script is NOT included in this repo; this file only documents the connection values it would need.
# Copy to a private location outside the project folder and fill in:
# it holds passwords.

# Metabase, and the admin account the script creates on the first run (or logs in with afterwards)
MB_URL=http://localhost:3000
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=choose-a-long-password

# Already connected the database by hand in Metabase? Put its name here (as shown in Admin > Databases)
# and leave the PG_ settings below as they are.
MB_DATABASE=

# Otherwise the script connects it: Supabase, through the Session pooler (Project settings > Database > Connection string > Session pooler)
# with the read-only login from setup/docs/TRANSFORMATION.md section 4.5:
#   create role metabase_reader login password '...' in role analytics_reader;
PG_HOST=aws-0-eu-central-1.pooler.supabase.com
PG_PORT=5432
PG_DB=postgres
PG_USER=metabase_reader.your-project-ref
PG_PASSWORD=the-metabase_reader-password
